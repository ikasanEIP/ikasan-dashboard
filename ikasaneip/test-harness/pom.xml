<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ikasan Dashboard end-to-end test harness (Playwright for Java + JUnit 5).

  Not part of the default build. Run with:
    mvn -Pall,e2e verify -pl test-harness -am
  Options:
    -Dharness.skip=true            skip the end-to-end run
    -Dharness.env=compose-mongo    harness environment (compose-mongo | compose-solr | external)
    -Dharness.include=smoke        only run tests/scenarios with any of these tags (comma separated)
    -Dharness.exclude=slow         skip tests/scenarios with any of these tags (comma separated)
    -Dit.test=SearchIT             run a single test class (standard failsafe option)
  Any harness setting can also be overridden with a HARNESS_* environment variable or a
  -Dharness.<section>.<key>=value system property (see config/harness.default.yaml).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.ikasan</groupId>
        <artifactId>ikasan-dashboard-build</artifactId>
        <version>5.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ikasan-test-harness</artifactId>
    <packaging>jar</packaging>
    <name>Ikasan Dashboard Test Harness</name>
    <description>Playwright end-to-end test harness for the Ikasan Dashboard</description>

    <properties>
        <version.com.microsoft.playwright>1.55.0</version.com.microsoft.playwright>
        <version.org.mongodb.driver-sync>5.8.1</version.org.mongodb.driver-sync>
        <version.tools.jackson.dataformat.yaml>3.1.0</version.tools.jackson.dataformat.yaml>
        <version.maven-failsafe-plugin>3.5.3</version.maven-failsafe-plugin>
        <version.dev.reportinglabs>0.1.35</version.dev.reportinglabs>
        <harness.skip>false</harness.skip>
        <harness.env>compose-mongo</harness.env>
        <harness.include />
        <harness.exclude />
        <!-- the Reporting Labs HTML report of the end-to-end tests (target/reporting-labs/index.html) -->
        <harness.report.reportingLabs>true</harness.report.reportingLabs>
        <!-- the end-to-end tests failsafe runs: each *IT on harness.env; with -Dharness.env=all (profile all-backends)
             the per-backend suites instead, which run every *IT on Mongo, then on Solr, in one JVM -->
        <harness.it.includes>**/*IT.java</harness.it.includes>
        <harness.report.title>Ikasan Dashboard end-to-end (${harness.env})</harness.report.title>
        <harness.report.env>${harness.env}</harness.report.env>
        <!-- nothing to deploy: the harness is only ever run from source -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!--
            Only here so that -am builds the dashboard jar first (the compose stack runs that jar).
            Its transitive dependencies are excluded: the harness needs none of them, and they would
            fail the parent's dependencyConvergence enforcer rule.
        -->
        <dependency>
            <groupId>org.ikasan</groupId>
            <artifactId>ikasan-dashboard</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
            Reporting Labs: a local, self-contained HTML report (no upload, no API key) with each test's Playwright
            steps, and a failure screenshot and trace. Compile scope: HarnessExtension (src/main) attaches the browser
            context to it. Enabled for the end-to-end tests only (failsafe, see harness.report.reportingLabs).
        -->
        <dependency>
            <groupId>dev.reportinglabs</groupId>
            <artifactId>reporting-labs-junit5</artifactId>
            <version>${version.dev.reportinglabs}</version>
        </dependency>
        <dependency>
            <groupId>dev.reportinglabs</groupId>
            <artifactId>reporting-labs-playwright</artifactId>
            <version>${version.dev.reportinglabs}</version>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${version.com.microsoft.playwright}</version>
        </dependency>
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>${version.org.mongodb.driver-sync}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${version.tools.jackson.dataformat.yaml}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- per-backend suites (MongoBackendSuite, SolrBackendSuite): both backends in one run -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- the parent pins junit-platform-commons to 1.10.2; Jupiter 5.14.4's engine needs the matching 1.14.4 -->
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-commons</artifactId>
                <version>1.14.4</version>
            </dependency>
            <!-- and the rest of the platform likewise, for the suite engine -->
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-engine</artifactId>
                <version>1.14.4</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>1.14.4</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-suite</artifactId>
                <version>1.14.4</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-suite-api</artifactId>
                <version>1.14.4</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-suite-engine</artifactId>
                <version>1.14.4</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-suite-commons</artifactId>
                <version>1.14.4</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- command line tools: mvn -q exec:java -Dexec.args="seed | stack up|down | capture <dataset>" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>org.ikasan.testharness.cli.HarnessCli</mainClass>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                    <systemProperties>
                        <systemProperty>
                            <key>harness.root</key>
                            <value>${project.basedir}</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
            <!-- unit tests of the harness itself (config, tokens, datasets) run in the normal test phase -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${version.maven-failsafe-plugin}</version>
            </plugin>
            <!-- the end-to-end tests (*IT) run against the dashboard in the integration-test phase -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${version.maven-failsafe-plugin}</version>
                <configuration>
                    <skipITs>${harness.skip}</skipITs>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <includes>
                        <include>${harness.it.includes}</include>
                    </includes>
                    <!-- MongoBackendSuite before SolrBackendSuite (within a run JUnit orders the classes itself) -->
                    <runOrder>alphabetical</runOrder>
                    <trimStackTrace>false</trimStackTrace>
                    <properties>
                        <!-- registers the Reporting Labs extension (its services entry) for the end-to-end tests only;
                             the harness's own unit tests (surefire) are not reported -->
                        <configurationParameters>junit.jupiter.extensions.autodetection.enabled = ${harness.report.reportingLabs}</configurationParameters>
                    </properties>
                    <systemPropertyVariables>
                        <harness.root>${project.basedir}</harness.root>
                        <reporting-labs.title>${harness.report.title}</reporting-labs.title>
                        <reporting-labs.metadata.env>${harness.report.env}</reporting-labs.metadata.env>
                        <reporting-labs.project.name>${project.name}</reporting-labs.project.name>
                        <reporting-labs.project.version>${project.version}</reporting-labs.project.version>
                        <reporting-labs.outputFolder>${project.build.directory}/reporting-labs</reporting-labs.outputFolder>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <HARNESS_ENV>${harness.env}</HARNESS_ENV>
                        <HARNESS_REPORT_REPORTINGLABS>${harness.report.reportingLabs}</HARNESS_REPORT_REPORTINGLABS>
                        <!-- no "star us on GitHub" line at the end of local runs -->
                        <REPORTING_LABS_NO_STAR>1</REPORTING_LABS_NO_STAR>
                        <HARNESS_RUN_INCLUDE>${harness.include}</HARNESS_RUN_INCLUDE>
                        <HARNESS_RUN_EXCLUDE>${harness.exclude}</HARNESS_RUN_EXCLUDE>
                    </environmentVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            mvn -Pall,e2e verify -pl test-harness -Dharness.env=all
            Runs every end-to-end test on Mongo and then on Solr in one JVM (MongoBackendSuite, SolrBackendSuite), so one
            Reporting Labs report covers both. Select tests with -Dharness.include=<tags>: -Dit.test bypasses the suites.
        -->
        <profile>
            <id>all-backends</id>
            <activation>
                <property>
                    <name>harness.env</name>
                    <value>all</value>
                </property>
            </activation>
            <properties>
                <harness.it.includes>**/*BackendSuite.java</harness.it.includes>
                <harness.report.title>Ikasan Dashboard end-to-end (mongo + solr)</harness.report.title>
                <harness.report.env>mongo + solr</harness.report.env>
            </properties>
        </profile>
    </profiles>
</project>
