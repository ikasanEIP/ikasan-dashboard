          "jobName": "after",
          "startupControlType": "AUTOMATIC",
          "identifier": "scheduler-agent-after"
        }
      ],
      "jobDependencies": [
        {
          "jobIdentifier": "scheduler-agent-trigger"
        },
        {
          "jobIdentifier": "scheduler-agent-failJob",
          "logicalGrouping": {
            "and": [
              {
                "identifier": "scheduler-agent-trigger"
              }
            ]
          }
        },
        {
          "jobIdentifier": "scheduler-agent-after",
          "logicalGrouping": {
            "and": [
              {
                "identifier": "scheduler-agent-failJob"
              }
            ]
          }
        }
      ]
    }
  ]
}
