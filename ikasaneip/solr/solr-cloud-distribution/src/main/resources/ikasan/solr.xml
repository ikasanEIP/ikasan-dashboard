<!--
   Ikasan SolrCloud Configuration

   This configuration is optimized for SolrCloud deployment with:
   - 1 shard
   - 3 replicas for high availability

   More information about SolrCloud configuration:
   https://solr.apache.org/guide/solr/latest/deployment-guide/solrcloud.html
-->

<solr>

  <!-- Maximum number of boolean clauses in a query -->
  <int name="maxBooleanClauses">${solr.max.booleanClauses:1024}</int>

  <solrcloud>

    <!-- Host and port settings for this Solr instance -->
    <str name="host">${host:}</str>
    <int name="hostPort">${jetty.port:8983}</int>
    <str name="hostContext">${hostContext:solr}</str>

    <!-- Use generic core node names for easier replica management -->
    <bool name="genericCoreNodeNames">${genericCoreNodeNames:true}</bool>

    <!-- ZooKeeper connection settings -->
    <int name="zkClientTimeout">${zkClientTimeout:30000}</int>
    <int name="distribUpdateSoTimeout">${distribUpdateSoTimeout:600000}</int>
    <int name="distribUpdateConnTimeout">${distribUpdateConnTimeout:60000}</int>

    <!-- ZooKeeper security providers -->
    <str name="zkCredentialsProvider">${zkCredentialsProvider:org.apache.solr.common.cloud.DefaultZkCredentialsProvider}</str>
    <str name="zkACLProvider">${zkACLProvider:org.apache.solr.common.cloud.DefaultZkACLProvider}</str>

    <!-- Leader vote wait time (milliseconds) -->
    <int name="leaderVoteWait">${leaderVoteWait:180000}</int>

    <!-- Leader conflict resolution wait time (milliseconds) -->
    <int name="leaderConflictResolveWait">${leaderConflictResolveWait:180000}</int>

  </solrcloud>

  <!-- Shard handler configuration for distributed requests -->
  <shardHandlerFactory name="shardHandlerFactory"
    class="HttpShardHandlerFactory">
    <int name="socketTimeout">${socketTimeout:600000}</int>
    <int name="connTimeout">${connTimeout:60000}</int>
    <str name="shardsWhitelist">${solr.shardsWhitelist:}</str>

    <!-- Thread pool settings for distributed requests -->
    <int name="maxConnectionsPerHost">${maxConnectionsPerHost:100}</int>
    <int name="maxConnections">${maxConnections:10000}</int>
  </shardHandlerFactory>

  <!-- Metrics reporter configuration -->
  <metrics enabled="${metricsEnabled:true}">
    <reporter name="jmx" class="org.apache.solr.metrics.reporters.SolrJmxReporter">
      <str name="rootName">solr_${hostPort:8983}</str>
    </reporter>
  </metrics>

</solr>
